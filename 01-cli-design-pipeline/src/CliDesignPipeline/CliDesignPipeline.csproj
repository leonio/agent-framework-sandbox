<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CliDesignPipeline</RootNamespace>
    <!-- Lets `dotnet user-secrets set Pipeline:ApiKey ...` work for this project. -->
    <UserSecretsId>agent-framework-samples-cli-design-pipeline</UserSecretsId>
  </PropertyGroup>

  <!--
    MCP is "commented out" with a build switch rather than literal comments so
    the code stays compiler-checked:
        dotnet run -p:EnableMcp=true
    adds the package and defines ENABLE_MCP, which switches
    Tools/GitHubMcpTools.cs from the mocked tools to a real MCP client.
  -->
  <PropertyGroup Condition="'$(EnableMcp)' == 'true'">
    <DefineConstants>$(DefineConstants);ENABLE_MCP</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="ModelContextProtocol" Condition="'$(EnableMcp)' == 'true'" />
  </ItemGroup>

  <!--
    The prompts / skills / instructions folders live at the SAMPLE root (not in
    src/) because they are content that non-developers (BAs, leads, QA) are
    expected to edit. They are linked in and copied next to the binary so the
    app finds them no matter where `dotnet run` is started from.
    Alternative: <EmbeddedResource> - tamper-proof, but then editing a prompt
    needs a rebuild, which defeats the point of keeping them as files.
  -->
  <ItemGroup>
    <None Include="..\..\prompts\**\*.md" LinkBase="prompts" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\skills\**\*.md" LinkBase="skills" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\instructions\**\*.md" LinkBase="instructions" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
