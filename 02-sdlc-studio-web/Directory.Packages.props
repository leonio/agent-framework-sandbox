<!--
  Central Package Management (CPM): every version lives here, projects only name packages.
  WHY: the API and the tests must agree on EF Core / Agent Framework versions; CPM makes
  drift impossible. Alternative: per-project Version attributes (what the older samples in the Agent-Framework-Samples repo do).

  Package choices:
  - Microsoft.Agents.AI(.Workflows): the Microsoft Agent Framework. The older samples in the Agent-Framework-Samples repo
    references the framework by project path (preview era); here we use the GA NuGet packages.
  - Microsoft.Extensions.AI(.OpenAI): the IChatClient abstraction. Every agent is built on an
    IChatClient, which is why the offline mock and the real model are interchangeable.
  - EF Core SqlServer (LocalDB) is the default store; Sqlite is included so the sample also
    runs on macOS/Linux and in the integration tests.
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.23.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.23.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Uncomment together with Tools/GitHubMcpTools.cs to talk to a real MCP server. -->
    <!-- <PackageVersion Include="ModelContextProtocol" Version="2.2.0" /> -->

    <!-- Tests -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
