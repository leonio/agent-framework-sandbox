<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>SdlcStudio.Api</RootNamespace>
    <UserSecretsId>sdlc-studio-web-sample</UserSecretsId>
    <!-- Lets the integration tests use WebApplicationFactory<Program> and see internal types. -->
    <InternalsVisibleTo>SdlcStudio.Tests</InternalsVisibleTo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- <PackageReference Include="ModelContextProtocol" /> see Tools/GitHubMcpTools.cs -->
  </ItemGroup>

  <ItemGroup>
    <!--
      The skills / prompts / instructions markdown files are the *seed* for the database.
      They are copied to the output so the app can (re)seed the Admin area at startup.
      After seeding, the database is the source of truth and edits made in the Admin UI win.
    -->
    <None Update="Content\**\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
