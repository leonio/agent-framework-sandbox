<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <!-- Test method names use underscores for readability. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- Prompts, mock responses, knowledge and the fixture PR flow into this output folder too. -->
    <!-- Global using, so test files need no `using Xunit;`. -->
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\MrArchitectureReview\MrArchitectureReview.csproj" />
  </ItemGroup>

</Project>
