<Project>
  <!--
    Versions as of 2 Oct 2026. Core Agent Framework is GA (1.23.0). The A2A SDK, the A2A client and server packages and
    the hosting package are all PREVIEW; that is the main risk this spike exists to size.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.23.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting" Version="1.23.0-preview.260928.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.AspNetCore" Version="1.23.0-preview.260928.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.A2A.AspNetCore" Version="1.23.0-preview.260928.1" />
    <PackageVersion Include="Microsoft.Agents.AI.A2A" Version="1.23.0-preview.260928.1" />
    <PackageVersion Include="A2A" Version="1.0.0-preview2" />
    <PackageVersion Include="A2A.AspNetCore" Version="1.0.0-preview2" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
  </ItemGroup>
</Project>
